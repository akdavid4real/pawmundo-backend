generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────
// 1. USER
// ─────────────────────────────────────────────────
enum UserRole {
  user
  vet
  clinic_admin
  admin
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  password               String
  firstName              String
  lastName               String
  role                   UserRole  @default(user)
  phone                  String?
  address                String?
  profileImage           String?
  isEmailVerified        Boolean   @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  lastLogin              DateTime?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  pets                   Pet[]
  appointments           Appointment[]
  assignedAppointments   Appointment[]          @relation("AppointmentVet")
  consultationsAsUser    Consultation[]      @relation("ConsultationUser")
  consultationsAsVet     Consultation[]      @relation("ConsultationVet")
  consultationNotes      ConsultationNote[]
  prescriptionsAsVet     Prescription[]      @relation("PrescriptionVet")
  prescriptionsAsOwner   Prescription[]      @relation("PrescriptionOwner")
  insurances             Insurance[]
  insuranceClaims        InsuranceClaim[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  subscription           UserSubscription?
  events                 Event[]
  forumPosts             ForumPost[]
  forumReplies           ForumReply[]
  forumLikes             ForumLike[]
  symptomChecks          SymptomCheck[]
  sentMessages           ConsultationMessage[] @relation("MessageSender")
  clinicMemberships      ClinicMembership[]    @relation("ClinicMember")
  clinicInvitesSent      ClinicMembership[]    @relation("ClinicInviteSender")
  clinicApprovals        ClinicMembership[]    @relation("ClinicMembershipApprover")

  @@map("users")
}

enum SubscriptionPlan {
  free
  plus
  pro
}

enum SubscriptionBillingCycle {
  monthly
  yearly
}

model UserSubscription {
  id                String                   @id @default(uuid())
  userId            String                   @unique
  plan              SubscriptionPlan         @default(free)
  billingCycle      SubscriptionBillingCycle @default(monthly)
  currency          String                   @default("NGN")
  paystackReference String?
  expiresAt         DateTime?
  isActive          Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user              User                     @relation(fields: [userId], references: [id])

  @@index([userId, isActive])
  @@map("user_subscriptions")
}

enum ClinicVerificationStatus {
  pending
  approved
  rejected
}

enum ClinicMembershipRole {
  clinic_admin
  vet
}

enum ClinicMembershipStatus {
  pending
  active
  suspended
  removed
}

model Clinic {
  id                    String                   @id @default(uuid())
  name                  String
  email                 String?
  phone                 String?
  address               String?
  registrationNumber    String?
  verificationDocuments String[]
  verificationStatus    ClinicVerificationStatus @default(pending)
  rejectionReason       String?
  isActive              Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  memberships           ClinicMembership[]
  appointments          Appointment[]
  consultations         Consultation[]

  @@index([verificationStatus, isActive])
  @@index([name])
  @@map("clinics")
}

model ClinicMembership {
  id           String                 @id @default(uuid())
  clinicId     String
  userId       String
  role         ClinicMembershipRole
  status       ClinicMembershipStatus @default(pending)
  invitedById  String?
  approvedById String?
  approvedAt   DateTime?
  removedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  clinic       Clinic                 @relation(fields: [clinicId], references: [id])
  user         User                   @relation("ClinicMember", fields: [userId], references: [id])
  invitedBy    User?                  @relation("ClinicInviteSender", fields: [invitedById], references: [id])
  approvedBy   User?                  @relation("ClinicMembershipApprover", fields: [approvedById], references: [id])

  @@unique([clinicId, userId])
  @@index([userId, status])
  @@index([clinicId, status, role])
  @@index([invitedById])
  @@index([approvedById])
  @@map("clinic_memberships")
}

// ─────────────────────────────────────────────────
// 2. PET
// ─────────────────────────────────────────────────
enum HealthStatus {
  healthy
  sick
  recovering
  chronic
}

model Pet {
  id                    String       @id @default(uuid())
  name                  String
  species               String
  breed                 String
  age                   Int
  gender                String
  weight                Float?
  color                 String?
  profileImage          String?
  ownerId               String
  dateOfBirth           DateTime?
  medicalNotes          String?
  allergies             String[]
  pastIllnesses         String[]
  surgeries             String[]
  dietaryPreferences    String?
  dietaryRestrictions   String[]
  behavioralNotes       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  healthStatus          HealthStatus @default(healthy)
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  owner                 User         @relation(fields: [ownerId], references: [id])
  appointments          Appointment[]
  consultations         Consultation[]
  prescriptions         Prescription[]
  medications           Medication[]
  activities            Activity[]
  healthRecords         HealthRecord[]
  insurances            Insurance[]
  notifications         Notification[]
  events                Event[]
  symptomChecks         SymptomCheck[]
  photos                PetPhoto[]

  @@index([ownerId, isActive])
  @@index([ownerId, species, isActive])
  @@index([ownerId, healthStatus, isActive])
  @@map("pets")
}

model PetPhoto {
  id        String   @id @default(uuid())
  petId     String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  pet       Pet      @relation(fields: [petId], references: [id])

  @@index([petId, createdAt(sort: Desc)])
  @@map("pet_photos")
}

// ─────────────────────────────────────────────────
// 3. APPOINTMENT
// ─────────────────────────────────────────────────
enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

model Appointment {
  id              String            @id @default(uuid())
  userId          String
  petId           String
  clinicId        String?
  assignedVetId   String?
  vetName         String
  vetClinic       String
  appointmentDate DateTime
  appointmentTime String
  reason          String
  status          AppointmentStatus @default(scheduled)
  notes           String?
  vetPhone        String?
  vetEmail        String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  pet             Pet               @relation(fields: [petId], references: [id])
  clinic          Clinic?           @relation(fields: [clinicId], references: [id])
  assignedVet     User?             @relation("AppointmentVet", fields: [assignedVetId], references: [id])

  @@index([clinicId, appointmentDate])
  @@index([assignedVetId, appointmentDate])
  @@map("appointments")
}

// ─────────────────────────────────────────────────
// 4. CONSULTATION
// ─────────────────────────────────────────────────
enum ConsultationStatus {
  pending
  assigned
  in_progress
  completed
  cancelled
}

enum ConsultationType {
  video
  audio
  chat
}

enum PaymentStatus {
  pending_payment
  paid
  refunded
}

model Consultation {
  id                String             @id @default(uuid())
  userId            String
  petId             String
  clinicId          String?
  assignedVetId     String?
  veterinarianName  String?
  status            ConsultationStatus @default(pending)
  scheduledDate     DateTime
  duration          Int                @default(30)
  reason            String
  symptoms          String?
  notes             String?
  prescription      String?
  followUpRequired  Boolean?
  followUpDate      DateTime?
  consultationType  ConsultationType   @default(video)
  meetingLink       String?
  meetingId         String?
  cost              Float              @default(0)
  paymentStatus     PaymentStatus      @default(pending_payment)
  unreadCount       Int                @default(0)
  lastMessageAt     DateTime?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  user              User               @relation("ConsultationUser", fields: [userId], references: [id])
  pet               Pet                @relation(fields: [petId], references: [id])
  clinic            Clinic?            @relation(fields: [clinicId], references: [id])
  assignedVet       User?              @relation("ConsultationVet", fields: [assignedVetId], references: [id])
  messages          ConsultationMessage[]
  consultationNotes ConsultationNote[]
  prescriptions     Prescription[]

  @@index([assignedVetId, status])
  @@index([clinicId, status])
  @@index([status, scheduledDate])
  @@map("consultations")
}

// ─────────────────────────────────────────────────
// 4a. CONSULTATION MESSAGE (was nested array)
// ─────────────────────────────────────────────────
model ConsultationMessage {
  id              String       @id @default(uuid())
  consultationId  String
  text            String
  senderId        String
  senderRole      String       // "user" or "doctor"
  isRead          Boolean      @default(false)
  createdAt       DateTime     @default(now())

  consultation    Consultation @relation(fields: [consultationId], references: [id])
  sender          User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([consultationId, createdAt])
  @@map("consultation_messages")
}

// ─────────────────────────────────────────────────
// 5. CONSULTATION NOTE
// ─────────────────────────────────────────────────
enum NoteType {
  observation
  diagnosis
  treatment
  followup
  other
}

model ConsultationNote {
  id              String       @id @default(uuid())
  consultationId  String
  vetId           String
  content         String
  isPrivate       Boolean      @default(true)
  noteType        NoteType     @default(observation)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  consultation    Consultation @relation(fields: [consultationId], references: [id])
  vet             User         @relation(fields: [vetId], references: [id])

  @@index([consultationId, vetId])
  @@map("consultation_notes")
}

// ─────────────────────────────────────────────────
// 6. PRESCRIPTION
// ─────────────────────────────────────────────────
enum PrescriptionStatus {
  active
  prescription_completed
  prescription_cancelled
}

model Prescription {
  id              String             @id @default(uuid())
  consultationId  String
  vetId           String
  petOwnerId      String
  petId           String
  medicationName  String
  dosage          String
  frequency       String
  duration        String
  instructions    String?
  warnings        String?
  notes           String?
  pdfUrl          String?
  status          PrescriptionStatus @default(active)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  consultation    Consultation       @relation(fields: [consultationId], references: [id])
  vet             User               @relation("PrescriptionVet", fields: [vetId], references: [id])
  petOwner        User               @relation("PrescriptionOwner", fields: [petOwnerId], references: [id])
  pet             Pet                @relation(fields: [petId], references: [id])

  @@index([consultationId])
  @@index([petOwnerId, status])
  @@map("prescriptions")
}

// ─────────────────────────────────────────────────
// 7. MEDICATION
// ─────────────────────────────────────────────────
enum MedicationFrequency {
  daily
  weekly
  monthly
  as_needed
}

model Medication {
  id            String              @id @default(uuid())
  petId         String
  name          String
  dosage        String
  frequency     MedicationFrequency
  startDate     DateTime
  endDate       DateTime?
  instructions  String?
  veterinarian  String?
  isActive      Boolean             @default(true)
  isCompleted   Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  pet           Pet                 @relation(fields: [petId], references: [id])

  @@map("medications")
}

// ─────────────────────────────────────────────────
// 8. ACTIVITY
// ─────────────────────────────────────────────────
enum ActivityType {
  walk
  play
  feeding
  water
  exercise
  activity_other
}

model Activity {
  id          String       @id @default(uuid())
  petId       String
  type        ActivityType
  date        DateTime
  duration    Int?         // minutes
  distance    Float?       // km
  foodAmount  Float?       // grams
  waterAmount Float?       // ml
  notes       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  pet         Pet          @relation(fields: [petId], references: [id])

  @@index([petId, date(sort: Desc)])
  @@index([petId, type, date(sort: Desc)])
  @@map("activities")
}

// ─────────────────────────────────────────────────
// 9. HEALTH RECORD
// ─────────────────────────────────────────────────
model HealthRecord {
  id          String   @id @default(uuid())
  petId       String
  type        String
  title       String
  description String?
  date        DateTime
  veterinarian String?
  clinic      String?
  attachments String[]
  nextDueDate DateTime?
  weight      Float?
  temperature Float?
  heartRate   Int?
  respiration Int?
  cost        Float?
  notes       String?
  isReminder  Boolean  @default(false)
  isCompleted Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pet         Pet      @relation(fields: [petId], references: [id])

  @@index([petId, isActive])
  @@index([petId, type, isActive])
  @@index([petId, date(sort: Desc)])
  @@index([nextDueDate, isActive])
  @@index([petId, nextDueDate])
  @@map("health_records")
}

// ─────────────────────────────────────────────────
// 10. INSURANCE
// ─────────────────────────────────────────────────
enum InsuranceStatus {
  insurance_active
  expired
  insurance_cancelled
  insurance_pending
}

model Insurance {
  id             String          @id @default(uuid())
  userId         String
  petId          String
  provider       String
  policyNumber   String
  planType       String
  monthlyPremium Float
  deductible     Float
  coverageLimit  Float
  startDate      DateTime
  endDate        DateTime
  status         InsuranceStatus @default(insurance_active)
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  pet            Pet             @relation(fields: [petId], references: [id])
  claims         InsuranceClaim[]

  @@map("insurances")
}

// ─────────────────────────────────────────────────
// 11. INSURANCE CLAIM
// ─────────────────────────────────────────────────
enum ClaimStatus {
  claim_pending
  approved
  denied
  processing
}

model InsuranceClaim {
  id             String      @id @default(uuid())
  insuranceId    String
  userId         String
  claimAmount    Float
  description    String
  serviceDate    DateTime
  provider       String?
  treatmentType  String?
  status         ClaimStatus @default(claim_pending)
  approvedAmount Float?
  denialReason   String?
  processedDate  DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  insurance      Insurance   @relation(fields: [insuranceId], references: [id])
  user           User        @relation(fields: [userId], references: [id])

  @@map("insurance_claims")
}

// ─────────────────────────────────────────────────
// 12. NOTIFICATION
// ─────────────────────────────────────────────────
enum NotificationType {
  appointment_notification
  medication_notification
  vaccination
  checkup
  weight_notification
  health_alert
  reminder
  info
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  petId     String?
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  actionUrl String?
  metadata  Json?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id])
  pet       Pet?             @relation(fields: [petId], references: [id])

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, petId, type])
  @@map("notifications")
}

// ─────────────────────────────────────────────────
// 13. NOTIFICATION PREFERENCE
// ─────────────────────────────────────────────────
model NotificationPreference {
  id                  String  @id @default(uuid())
  userId              String  @unique
  globalEnabled       Boolean @default(true)
  petSettings         Json    @default("{}")
  emailNotifications  Boolean @default(true)
  pushNotifications   Boolean @default(true)
  reminderHoursBefore Int     @default(24)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User    @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────
// 14. EVENT
// ─────────────────────────────────────────────────
enum EventCategory {
  event_appointment
  event_vaccination
  event_medication
  grooming
  training
  event_other
}

enum EventStatus {
  event_scheduled
  event_completed
  event_cancelled
}

model Event {
  id            String        @id @default(uuid())
  userId        String
  petId         String?
  title         String
  description   String
  eventDate     DateTime
  eventTime     String?
  category      EventCategory
  status        EventStatus   @default(event_scheduled)
  location      String?
  notes         String?
  isRecurring   Boolean       @default(false)
  recurringType String?       // daily, weekly, monthly, yearly
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  pet           Pet?          @relation(fields: [petId], references: [id])

  @@map("events")
}

// ─────────────────────────────────────────────────
// 15. FORUM POST (nested arrays → separate tables)
// ─────────────────────────────────────────────────
enum ForumCategory {
  general
  health
  forum_training
  nutrition
  behavior
}

model ForumPost {
  id        String        @id @default(uuid())
  title     String
  content   String
  category  ForumCategory
  authorId  String
  viewCount Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  author    User          @relation(fields: [authorId], references: [id])
  replies   ForumReply[]
  likes     ForumLike[]

  @@index([category, isActive, createdAt(sort: Desc)])
  @@index([authorId, isActive])
  @@map("forum_posts")
}

model ForumReply {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime  @default(now())

  post      ForumPost @relation(fields: [postId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
  @@map("forum_replies")
}

model ForumLike {
  id        String    @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime  @default(now())

  post      ForumPost @relation(fields: [postId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@map("forum_likes")
}

// ─────────────────────────────────────────────────
// 16. SYMPTOM CHECK
// ─────────────────────────────────────────────────
model SymptomCheck {
  id                  String   @id @default(uuid())
  userId              String
  petId               String
  petName             String
  symptoms            String[]
  duration            String
  severity            String
  additionalInfo      String?
  urgencyLevel        String
  possibleConditions  String[]
  recommendations     String[]
  vetRequired         Boolean
  warningSignsToWatch String[]
  personalizedMessage String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id])
  pet                 Pet      @relation(fields: [petId], references: [id])

  @@map("symptom_checks")
}
